{
  "manifest_version": 3,
  "minimum_chrome_version": "148",
  "message_serialization": "structured_clone",
  "name": "Uncensored YouTube",
  "version": "1.5.2",
  "description": "Restores words censored in YouTube's automatic captions.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/rules-compiler.js",
        "src/rule-data/language.js",
        "src/rule-data/exact.js",
        "src/rule-data/grammar.js",
        "src/rules-data.js",
        "src/rules.js",
        "src/timedtext.js",
        "src/sabr-parser.js",
        "src/audio-capture.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-hook.js",
        "src/rules-compiler.js",
        "src/rule-data/language.js",
        "src/rule-data/exact.js",
        "src/rule-data/grammar.js",
        "src/rules-data.js",
        "src/rules.js",
        "src/timedtext.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
