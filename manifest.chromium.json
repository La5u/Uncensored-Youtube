{
  "manifest_version": 3,
  "name": "Uncensored YouTube",
  "version": "1.0.1",
  "description": "Restores deterministic censored words in YouTube captions.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/rules.js",
        "src/timedtext.js",
        "src/audio-capture.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/rules.js",
        "src/timedtext.js",
        "src/sabr-parser.js",
        "src/sabr-worker.js",
        "src/whisper-local.js",
        "src/whisper-module-worker.js",
        "src/vendor/transformers.min.js",
        "src/vendor/ort-wasm-simd-threaded.asyncify.wasm",
        "src/vendor/ort-wasm-simd-threaded.asyncify.mjs",
        "src/models/whisper-tiny.en/**",
        "src/page-hook.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
