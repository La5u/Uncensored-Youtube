{
  "manifest_version": 3,
  "name": "Uncensored YouTube",
  "version": "0.9.0",
  "description": "Restores deterministic censored words in YouTube captions.",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uncensored@lasu.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/rules.js",
        "src/timedtext.js",
        "src/sabr-parser.js",
        "src/audio-capture.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/rules.js",
        "src/timedtext.js",
        "src/sabr-parser.js",
        "src/whisper-local.js",
        "src/whisper-module-worker.js",
        "src/vendor/transformers.min.js",
        "src/vendor/ort-wasm-simd-threaded.asyncify.wasm",
        "src/vendor/ort-wasm-simd-threaded.asyncify.mjs",
        "src/models/whisper-tiny.en/**",
        "src/page-hook.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
