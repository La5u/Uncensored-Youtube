{
  "manifest_version": 3,
  "name": "Uncensored YouTube",
  "version": "1.3.3",
  "description": "Restores words censored in YouTube's automatic captions.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uncensored@lasu.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/rules-compiler.js",
        "src/rules-data.js",
        "src/rules.js",
        "src/timedtext.js",
        "src/sabr-parser.js",
        "src/audio-capture.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page-hook.js",
        "src/rules-compiler.js",
        "src/rules-data.js",
        "src/rules.js",
        "src/timedtext.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
