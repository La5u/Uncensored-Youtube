{
  "manifest_version": 3,
  "name": "Uncensored YouTube",
  "version": "0.1.0",
  "description": "Restores deterministic censored words in YouTube captions.",
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uncensored-youtube@lasu.dev",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/rule-data.js",
        "src/replacement-format.js",
        "src/rules.js",
        "src/timedtext.js",
        "src/page-hook.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
